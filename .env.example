# ==============================================================================
# ACME Employee Salary Management System — Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acme_salary_db
DB_USER=postgres
DB_PASSWORD=root

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security
# Minimum 256-bit (32 bytes) secret for HMAC-SHA256 signature
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://127.0.0.1:4200

# Seed Configuration
SEED_INITIAL_DATA=true
SEED_EMPLOYEE_COUNT=10000
SEED_ADMIN_PASSWORD=Admin@Acme2026!
SEED_MANAGER_PASSWORD=Manager@Acme2026!
SEED_VIEWER_PASSWORD=Viewer@Acme2026!
