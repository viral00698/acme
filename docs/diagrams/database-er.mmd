erDiagram
    COUNTRIES ||--o{ EMPLOYEES : located_in
    DEPARTMENTS ||--o{ EMPLOYEES : works_in
    JOB_TITLES ||--o{ EMPLOYEES : assigned_to
    EMPLOYEES ||--o{ SALARY_RECORDS : compensation_history
    CURRENCIES ||--o{ SALARY_RECORDS : denominated_in

    USER_ACCOUNTS ||--o{ USER_ROLES : assigned
    ROLES ||--o{ USER_ROLES : has
    USER_ACCOUNTS ||--o{ REFRESH_TOKENS : owns
    USER_ACCOUNTS ||--o{ AUDIT_LOGS : performs

    COUNTRIES {
        bigint id PK
        varchar code UK
        varchar name
        varchar default_currency_code
    }

    DEPARTMENTS {
        bigint id PK
        varchar code UK
        varchar name
    }

    JOB_TITLES {
        bigint id PK
        varchar title UK
        bigint department_id FK
    }

    CURRENCIES {
        varchar code PK
        varchar name
        varchar symbol
    }

    EMPLOYEES {
        bigint id PK
        varchar employee_code UK
        varchar first_name
        varchar last_name
        varchar email UK
        varchar phone_number
        bigint department_id FK
        bigint country_id FK
        bigint job_title_id FK
        varchar status
        date hire_date
        timestamp created_at
        timestamp updated_at
    }

    SALARY_RECORDS {
        bigint id PK
        bigint employee_id FK
        numeric amount
        varchar currency_code FK
        varchar pay_frequency
        date effective_from
        date effective_to
        bigint created_by_id FK
        timestamp created_at
        bigint version
    }

    USER_ACCOUNTS {
        bigint id PK
        varchar username UK
        varchar email UK
        varchar password_hash
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    ROLES {
        bigint id PK
        varchar name UK
        varchar description
    }

    USER_ROLES {
        bigint user_id PK_FK
        bigint role_id PK_FK
    }

    REFRESH_TOKENS {
        bigint id PK
        bigint user_id FK
        varchar token_hash UK
        timestamp expiry_date
        boolean revoked
        timestamp created_at
    }

    AUDIT_LOGS {
        bigint id PK
        varchar actor_username
        varchar entity_name
        bigint entity_id
        varchar action
        text details_json
        varchar client_ip
        timestamp created_at
    }
